{
  "name":              "dreamfactory/df-soap",
  "description":       "SOAP Service for the DreamFactory Platform 2.0.",
  "minimum-stability": "dev",
  "keywords":          [
    "dreamfactory",
    "api",
    "rest",
    "soap",
    "wsdl"
  ],
  "homepage":          "https://www.dreamfactory.com/",
  "license":           "proprietary",
  "authors":           [
    {
      "name":  "Arif Islam",
      "email": "arifislam@dreamfactory.com"
    },
    {
      "name":  "Lee Hicks",
      "email": "leehicks@dreamfactory.com"
    }
  ],
  "support":           {
    "email":  "dspsupport@dreamfactory.com",
    "source": "https://github.com/dreamfactorysoftware/df-soap",
    "issues": "https://github.com/dreamfactorysoftware/df-soap/issues",
    "wiki":   "https://wiki.dreamfactory.com"
  },
  "prefer-stable": true,
  "require":           {
    "php": "^8.3",
    "ext-soap": "*",
    "laravel/helpers": "^1.8",
    "dreamfactory/df-core": "~1.0.17"
  },
  "require-dev": {
    "laravel/framework": "^13.7",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5.3",
    "orchestra/testbench": "^11.0"
  },
  "autoload":          {
    "psr-4": {
      "DreamFactory\\Core\\Soap\\": "src/"
    }
  },
  "extra":             {
    "branch-alias": {
      "dev-develop": "0.14.x-dev"
    },
    "laravel": {
      "providers": [
        "DreamFactory\\Core\\Soap\\ServiceProvider"
      ]
    }
  }
}
